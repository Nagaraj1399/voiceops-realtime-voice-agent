# ASSEMBLYAI_API_KEY: AssemblyAI API Key for Real-time Voice Agent & Universal Speech Recognition
ASSEMBLYAI_API_KEY=""

# GEMINI_API_KEY: Required for fallback or secondary LLM reasoning
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Optional external database connection string
DATABASE_URL=""

# PORT: Server runtime port (default 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

